{
  "name": "cdi-poc-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "Local, read-only explorer for the cross-layer dependency graph (structure only; synthetic sample data)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "licenses": "node scripts/licenses.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "cytoscape": "3.35.0",
    "cytoscape-dagre": "4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
